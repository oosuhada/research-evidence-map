# Frontend
VITE_API_BASE=/api

# API / database
SIGNAL_GARDEN_DATABASE_URL=postgresql+psycopg://signal_garden:signal_garden@127.0.0.1:54329/signal_garden
SIGNAL_GARDEN_CORS_ORIGINS=http://localhost:3101
SIGNAL_GARDEN_RETENTION_DAYS=30

# AI adapter. deterministic requires no credentials.
SIGNAL_GARDEN_AI_PROVIDER=deterministic
SIGNAL_GARDEN_AI_MODEL=signal-garden-deterministic-v1
SIGNAL_GARDEN_AI_API_KEY=
SIGNAL_GARDEN_AI_BASE_URL=
SIGNAL_GARDEN_AI_TIMEOUT_SECONDS=30
SIGNAL_GARDEN_AI_MAX_RETRIES=2
SIGNAL_GARDEN_AI_RATE_LIMIT_PER_MINUTE=30
